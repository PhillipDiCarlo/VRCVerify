# Version control
.git
.gitignore
.gitattributes

# IDE/OS
.vscode/
.idea/
.DS_Store

# Python caches and virtual envs
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.venv/
venv/

# Environment files.
#
# These need `**/` and it is not decoration. Docker does NOT use gitignore
# semantics: a pattern without a slash is matched against the WHOLE path
# relative to the context root, not against the basename at any depth. So
# plain `.env` excludes only the root file, and `dashboard.env` or `*.env`
# would NOT have excluded config/other_configs/dashboard.env -- verified by
# building a context both ways. Do not "simplify" these back.
#
# dashboard.env holds the Discord client secret, the bot API signing key and
# the Stripe secret key. By the same reasoning as certs/ below, it must never
# enter the build context at all, not merely never be COPYed.
**/*.env
!**/*.env.example

# mTLS material for the bot API (scripts/gen_bot_api_certs.*). These must never
# enter the build context at all -- not merely "never be COPYed". Anything in
# the context is uploaded to the Docker daemon, ends up in the build cache, and
# is one careless `COPY . .` away from being baked into a published image.
# ca.key in particular can mint a client the bot will trust.
certs/
*.key
*.pem
*.csr
*.srl

# Local security documentation (gitignored too, but belt and braces)
SECURITY_AUDIT.md
VPS_RUNBOOK.md

# Tests and local assets not needed in images
tests/
Logos/

# Cache/coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Local scripts not required in image
 tag_and_push_images.ps1
 tag_and_push_images.sh

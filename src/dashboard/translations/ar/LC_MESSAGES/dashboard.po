msgstr[2] "عضوان يمكن توثيقهما الآن"
msgstr[3] "%(count)s أعضاء يمكن توثيقهم الآن"
msgstr[4] "%(count)s عضوًا يمكن توثيقهم الآن"
msgstr[5] "%(count)s عضو يمكن توثيقهم الآن"


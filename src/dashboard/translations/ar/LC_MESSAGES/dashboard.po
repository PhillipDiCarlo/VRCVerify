msgid_plural "%(count)s members are linked to VRChat but not 18+ verified"
msgstr[0] "لا أعضاء مرتبطون بـ VRChat دون توثيق 18+"
msgstr[1] "عضو واحد مرتبط بـ VRChat لكنه غير موثَّق 18+"
msgstr[2] "عضوان مرتبطان بـ VRChat لكنهما غير موثَّقين 18+"

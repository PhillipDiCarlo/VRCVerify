msgstr "جديد في Premium: %(title)s"

msgid "Today (UTC)"
msgstr "اليوم (بالتوقيت العالمي)"

msgid "Last 7 days"
msgstr "آخر 7 أيام"

msgid "Last 30 days"
msgstr "آخر 30 يومًا"

msgid "Couldn't check"
msgstr "تعذّر التحقّق"

msgid "The bot didn't answer this one."
msgstr "لم يردّ البوت على هذا."

msgid "Not collecting that far back yet."
msgstr "لا يجري بعد جمع البيانات إلى هذا الحد من الماضي."

#, python-format

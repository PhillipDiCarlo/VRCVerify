msgstr "لا يرتبط بـ VRChat Inc. أو Discord Inc.، ولا يحظى بموافقتهما أو رعايتهما."

# | msgid "Pricing · VRCVerify"
msgid "What's new · VRCVerify"
msgstr "ما الجديد · VRCVerify"

msgid "Everything that has shipped in VRCVerify, newest first."
msgstr "كل ما صدر في VRCVerify، الأحدث أولًا."

msgid ""
"There is a <a href=\"https://vrcverify.com/changelog\">public version of "
"this page</a> you can share with anyone."
msgstr ""
"هناك <a href=\"https://vrcverify.com/changelog\">نسخة عامة من هذه "
"الصفحة</a> يمكنك مشاركتها مع أي شخص."

#, python-format
msgid ""
"Want these in your own server? <a href=\"%(invite)s\" target=\"_blank\" "
"rel=\"noopener noreferrer\">Join the VRCVerify Discord</a> and follow the"
" announcements channel — every update here gets posted there, and Discord"
" crossposts it to any channel you pick."
msgstr ""
"أتريد هذه في خادمك أنت؟ <a href=\"%(invite)s\" target=\"_blank\" "
"rel=\"noopener noreferrer\">انضمّ إلى Discord الخاص بـ VRCVerify</a> "
"وتابع قناة الإعلانات؛ فكل تحديث هنا يُنشر هناك، وDiscord ينقله إلى أي "
"قناة تختارها."


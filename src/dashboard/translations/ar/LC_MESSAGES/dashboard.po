msgstr[5] "%(count)s عضو مرتبطون بـ VRChat لكنهم غير موثَّقين 18+"

msgid ""
"They can press Begin Verification on the instructions panel to be checked"
" again."
msgstr "يمكنهم الضغط على «بدء التحقق» في لوحة الإرشادات ليُفحَصوا مرة أخرى."

#, python-format
msgid "%(count)s member hasn't verified with VRCVerify yet"
msgid_plural "%(count)s members haven't verified with VRCVerify yet"
msgstr[0] "لم يوثّق أي عضو نفسه بعد عبر VRCVerify"
msgstr[1] "عضو واحد لم يوثّق نفسه بعد عبر VRCVerify"
msgstr[2] "عضوان لم يوثّقا أنفسهما بعد عبر VRCVerify"
msgstr[3] "%(count)s أعضاء لم يوثّقوا أنفسهم بعد عبر VRCVerify"
msgstr[4] "%(count)s عضوًا لم يوثّقوا أنفسهم بعد عبر VRCVerify"
msgstr[5] "%(count)s عضو لم يوثّقوا أنفسهم بعد عبر VRCVerify"

msgid ""
"Nobody can do this step for them: they verify once, with the instructions"
" panel, and every server using VRCVerify recognizes them after that."
msgstr ""
"لا يستطيع أحد القيام بهذه الخطوة نيابة عنهم: يوثّقون أنفسهم مرة واحدة عبر"
" لوحة الإرشادات، ويتعرّف عليهم بعدها كل خادم يستخدم VRCVerify."

#, python-format
msgid "Done. %(count)s member was given the verified role."
msgid_plural "Done. %(count)s members were given the verified role."
msgstr[0] "تم. لم يحصل أي عضو على رتبة «موثَّق»."
msgstr[1] "تم. حصل عضو واحد على رتبة «موثَّق»."
msgstr[2] "تم. حصل عضوان على رتبة «موثَّق»."
msgstr[3] "تم. حصل %(count)s أعضاء على رتبة «موثَّق»."
msgstr[4] "تم. حصل %(count)s عضوًا على رتبة «موثَّق»."
msgstr[5] "تم. حصل %(count)s عضو على رتبة «موثَّق»."

#, python-format
msgid "%(count)s member couldn't be updated and can still verify with the panel."
msgid_plural "%(count)s members couldn't be updated and can still verify with the panel."
msgstr[0] "لم يتعذّر تحديث أي عضو، وكلهم يمكنهم التوثيق عبر اللوحة."
msgstr[1] "تعذّر تحديث عضو واحد، وما زال بإمكانه التوثيق عبر اللوحة."
msgstr[2] "تعذّر تحديث عضوين، وما زال بإمكانهما التوثيق عبر اللوحة."
msgstr[3] "تعذّر تحديث %(count)s أعضاء، وما زال بإمكانهم التوثيق عبر اللوحة."
msgstr[4] "تعذّر تحديث %(count)s عضوًا، وما زال بإمكانهم التوثيق عبر اللوحة."
msgstr[5] "تعذّر تحديث %(count)s عضو، وما زال بإمكانهم التوثيق عبر اللوحة."

#, python-format
msgid "You can verify members again after %(when)s."
msgstr "يمكنك توثيق الأعضاء مرة أخرى بعد %(when)s."

#, python-format
msgid "Give %(count)s member the verified role"
msgid_plural "Give %(count)s members the verified role"
msgstr[0] "امنح رتبة «موثَّق» للأعضاء"
msgstr[1] "امنح رتبة «موثَّق» لعضو واحد"
msgstr[2] "امنح رتبة «موثَّق» لعضوين"
msgstr[3] "امنح رتبة «موثَّق» لـ %(count)s أعضاء"
msgstr[4] "امنح رتبة «موثَّق» لـ %(count)s عضوًا"
msgstr[5] "امنح رتبة «موثَّق» لـ %(count)s عضو"

msgid "Working"
msgstr "يعمل"

# | msgid "Setup isn't finished"
msgid "Setup unfinished"
msgstr "الإعداد غير مكتمل"

# | msgid "needs attention"
msgid "Needs attention"
msgstr "يحتاج انتباهك"

# | msgid "not set"
msgid "Not set up"
msgstr "غير مُعدّ"

# | msgid "Couldn't check"
msgid "Can't check"
msgstr "تعذّر التحقّق"

msgid "Set up and working"
msgstr "مُعدّ ويعمل"

msgid "Setup isn't finished"
msgstr "الإعداد غير مكتمل"

# | msgid "Something went wrong."
msgid "Something isn't working"
msgstr "هناك ما لا يعمل"

msgid "Not set up here, or not yours to manage"
msgstr "غير مُعدّ هنا، أو ليس من إدارتك"

msgid "Can't check this server right now"
msgstr "لا يمكن فحص هذا الخادم الآن"

# | msgid "A verification log channel"
msgid "Verification"
msgstr "التوثيق"

msgid "After verifying"
msgstr "بعد التوثيق"

msgid "VRChat group"
msgstr "مجموعة VRChat"

msgid "Logging"
msgstr "السجلّات"


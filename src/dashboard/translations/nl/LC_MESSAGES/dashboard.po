msgstr "Instellen"

# | msgid "Your grandfathered extras stay free whatever you decide."
#, python-format
msgid "Your grandfathered extras stay free whatever you decide. %(body)s"
msgstr "Je overgenomen extra's blijven gratis, wat je ook besluit. %(body)s"

#, python-format
msgid "New in Premium: %(title)s"
msgstr "Nieuw in Premium: %(title)s"

msgid "Today (UTC)"
msgstr "Vandaag (UTC)"

msgid "Last 7 days"
msgstr "Laatste 7 dagen"

msgid "Last 30 days"
msgstr "Laatste 30 dagen"

msgid "Couldn't check"
msgstr "Kon niet gecontroleerd worden"

msgid "The bot didn't answer this one."
msgstr "De bot heeft hier niet op geantwoord."


msgstr "Algo no está funcionando"

msgid "Not set up here, or not yours to manage"
msgstr "No está configurado aquí, o no es tuyo para gestionar"

msgid "Can't check this server right now"
msgstr "Ahora mismo no se puede comprobar este servidor"

msgid "Verification"
msgstr "Verificación"


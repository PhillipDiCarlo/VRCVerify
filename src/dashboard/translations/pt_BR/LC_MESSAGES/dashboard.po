# | msgid "Settings"
msgid "Go to Settings"
msgstr "Ir para Configurações"

msgid "Verified role"
msgstr "Cargo de verificado"

# | msgid "Pick a verified role -- verification can't run without one."
msgid "Required — verification can't finish without one."
msgstr "Obrigatório — sem ele a verificação não termina."

msgid "The role that was set has been deleted. Choose another."
msgstr "O cargo que estava configurado foi apagado. Escolha outro."

msgid "VRCVerify's own role needs to sit above this one to grant it."
msgstr ""
"O próprio cargo do VRCVerify precisa ficar acima deste para poder "
"concedê-lo."

msgid "Set, and VRCVerify can grant it."
msgstr "Configurado, e o VRCVerify consegue concedê-lo."

# | msgid "A branded instructions panel"
msgid "Instructions panel"
msgstr "Painel de instruções"

msgid "Members need a message to start from."
msgstr "Os membros precisam de uma mensagem por onde começar."

msgid "The channel it was posted in was deleted."
msgstr "O canal onde foi publicado foi apagado."

msgid "VRCVerify can't post there anymore — check its permissions."
msgstr "O VRCVerify não consegue mais publicar ali — confira as permissões."

msgid "Posted, and VRCVerify can still reach it."
msgstr "Publicado, e o VRCVerify ainda consegue alcançá-lo."

msgid "No verified role is set"
msgstr "Nenhum cargo de verificado está configurado"

msgid "The verified role needs attention"
msgstr "O cargo de verificado precisa de atenção"

# | msgid "A branded instructions panel"
# | msgid "Instructions panel"
msgid "No instructions panel is posted"
msgstr "Nenhum painel de instruções foi publicado"

# | msgid "A branded instructions panel"
# | msgid "Instructions panel"
msgid "The instructions panel needs attention"
msgstr "O painel de instruções precisa de atenção"

#, python-format
msgid ""
"%(count)s member verified here in the last 30 days. Premium logs each one"
" to a channel of your choice."
msgid_plural ""
"%(count)s members verified here in the last 30 days. Premium logs each "
"one to a channel of your choice."
msgstr[0] ""
"%(count)s membro se verificou aqui nos últimos 30 dias. O Premium "
"registra cada um em um canal à sua escolha."
msgstr[1] ""
"%(count)s membros se verificaram aqui nos últimos 30 dias. O Premium "
"registra cada um em um canal à sua escolha."

msgid "Add VRCVerify Premium"
msgstr "Adicionar o VRCVerify Premium"

msgid "Your grandfathered extras stay free whatever you decide."
msgstr "Seus extras antigos continuam grátis, decida o que decidir."

msgid "Upgrade to VRCVerify Premium"
msgstr "Assinar o VRCVerify Premium"

# | msgid "A verification log channel"
msgid "Verification"
msgstr "Verificação"

msgid "After verifying"
msgstr "Depois de verificar"

msgid "VRChat group"
msgstr "Grupo do VRChat"

msgid "Logging"
msgstr "Registro"

# | msgid "Active"
msgid "Activity"
msgstr "Atividade"


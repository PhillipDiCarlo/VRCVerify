msgid "Only counting since %(date)s."
msgstr "Só conta desde %(date)s."

msgid "Members"
msgstr "Membros"

# | msgid "A verification log channel"
# | msgid "Verification"
msgid "Verified, all time"
msgstr "Verificados, no total"

msgid "Counted since this server's records began."
msgstr "Contado desde que começaram os registros deste servidor."

msgid "Not collecting yet."
msgstr "Ainda não está guardando nada."

msgid "Auto-verify on join"
msgstr "Verificar automaticamente ao entrar"

msgid "Members are checked when they join."
msgstr "Os membros são checados quando entram."

msgid "Unverified role"
msgstr "Cargo de não verificado"

msgid "Optional. Removed once someone verifies."
msgstr "Opcional. Removido assim que alguém se verifica."

# | msgid "A verification log channel"
# | msgid "Verification"
msgid "Verification log"
msgstr "Registro de verificações"

msgid "Optional. Premium."
msgstr "Opcional. Premium."


#. key: already_verified
msgid "You're already verified! Role assigned (or re-assigned)."
msgstr "¡Ya estás verificado! Rol asignado (o reasignado)."

#. key: bio_verify_instructions1
msgid "**1)** Add the code to your VRChat bio on its own line."
msgstr "**1)** Añade el código a tu biografía de VRChat en su propia línea."

#. key: bio_verify_instructions2
msgid "**2)** Once your bio is updated, click **Verify** in Discord (within 10 minutes)."
msgstr "**2)** Una vez actualizada, haz clic en **Verificar** en Discord (dentro de 10 minutos)."

#. key: btn_begin_verification
msgid "Begin Verification"
msgstr "Iniciar Verificación"

#. key: btn_donate
msgid "Donate"
msgstr "Donar"

#. key: btn_group_invite
msgid "Send me an invite"
msgstr "Envíame una invitación"

#. key: btn_update_nickname
msgid "Update Nickname"
msgstr "Actualizar Apodo"

#. key: code_not_found
msgid ""
"We couldn't find your code in your VRChat bio. Please try again. \n"
"**Double check that the code is on its own line.**"
msgstr ""
"No pudimos encontrar tu código en tu biografía de VRChat. Inténtalo de nuevo. \n"
"**Comprueba que el código esté en su propia línea.**"

#. key: cooldown_active
#, python-brace-format
msgid "You're doing that too fast. Please wait {seconds} seconds and try again."
msgstr "Vas demasiado rápido. Espera {seconds} segundos e inténtalo de nuevo."

#. key: custom_msg_cleared
msgid "Custom verification request message cleared. Default will be used."
msgstr "Mensaje de solicitud de verificación personalizado borrado. Se usará el predeterminado."

#. key: custom_msg_invalid_links
#, python-brace-format
msgid ""
"Blocked: Only discord.com or vrchat.com links allowed. Invalid link(s):\n"
"{invalid_list}"
msgstr ""
"Bloqueado: Solo se permiten enlaces de discord.com o vrchat.com. Enlace(s) no válido(s):\n"
"{invalid_list}"

#. key: custom_msg_saved
msgid "Custom verification request message saved."
msgstr "Mensaje de solicitud de verificación personalizado guardado."

#. key: custom_msg_too_long
msgid "Message too long (max 1000 characters)."
msgstr "Mensaje demasiado largo (máx. 1000 caracteres)."

#. key: dm_group_invite_offer
#, python-brace-format
msgid ""
"You're verified in **{server}**! Would you like an invite to their VRChat group, **{group}**?\n"
"\n"
"Nothing is sent to VRChat unless you press the button."
msgstr ""
"¡Estás verificado en **{server}**! ¿Quieres una invitación a su grupo de VRChat, **{group}**?\n"
"\n"
"No se envía nada a VRChat a menos que pulses el botón."

#. key: dm_role_failed_bot_position
#, python-brace-format
msgid "I couldn't assign the '{role}' role in {server}. This usually happens when the VRCVerify bot's role is not above the verified (and unverified) roles in the server's role list. Please ask a server admin to move the VRCVerify bot role above those roles and try again."
msgstr "No pude asignar el rol '{role}' en {server}. Esto suele ocurrir cuando el rol del bot VRCVerify no está por encima de los roles verificado (y no verificado) en la lista de roles del servidor. Pide a un administrador que mueva el rol del bot VRCVerify por encima de esos roles e inténtalo de nuevo."

#. key: dm_role_success
#, python-brace-format
msgid "You've been verified and given **{role}** in **{server}**!"
msgstr "¡Has sido verificado y se te ha asignado **{role}** en **{server}**!"

#. key: dm_unverified_failed_bot_position
#, python-brace-format
msgid "Could not remove the {role} role in {server}. This usually happens when the VRCVerify bot's role is not above the unverified role. Ask a server admin to verify that the VRCVerify bot's role is above both the verified and unverified (if applicable)."
msgstr "No se pudo quitar el rol {role} en {server}. Esto suele ocurrir cuando el rol del bot VRCVerify no está por encima del rol de no verificado. Pide a un administrador del servidor que compruebe que el rol del bot VRCVerify está por encima tanto del rol de verificado como del de no verificado (si procede)."

#. key: group_invite_account_changed
msgid "This offer was for a different VRChat account than the one you have linked now. Verify again to get a new invite offer for your current account."
msgstr "Esta invitación era para una cuenta de VRChat distinta a la que tienes vinculada ahora. Verifícate de nuevo para recibir una nueva invitación para tu cuenta actual."

#. key: group_invite_account_missing
msgid "VRChat didn't recognise the account you verified with, so the invite couldn't be sent. Try verifying again to relink your VRChat account."
msgstr "VRChat no reconoció la cuenta con la que te verificaste, así que no se pudo enviar la invitación. Vuelve a verificarte para volver a vincular tu cuenta de VRChat."

#. key: group_invite_already_invited
#, python-brace-format
msgid "An invite to **{group}** is already waiting in your VRChat notifications."
msgstr "Ya tienes una invitación a **{group}** esperando en tus notificaciones de VRChat."

#. key: group_invite_already_member
#, python-brace-format
msgid "You're already in **{group}**, so there's nothing to send."
msgstr "Ya estás en **{group}**, así que no hay nada que enviar."

#. key: group_invite_banned
#, python-brace-format
msgid "You can't be invited to **{group}**. Only a group moderator can change that."
msgstr "No puedes recibir invitaciones a **{group}**. Solo un moderador del grupo puede cambiarlo."

#. key: group_invite_blocked
msgid "VRChat wouldn't deliver the invite. Group invites may be switched off in your VRChat settings, or the group may be blocked on your account."
msgstr "VRChat no pudo entregar la invitación. Puede que tengas las invitaciones de grupo desactivadas en los ajustes de VRChat, o que el grupo esté bloqueado en tu cuenta."

#. key: group_invite_not_a_member
#, python-brace-format
msgid "This invite was for **{server}**, and you're no longer a member there. Join the server and verify again if you'd still like an invite."
msgstr "Esta invitación era para **{server}**, y ya no eres miembro de ese servidor. Únete al servidor y verifícate de nuevo si aún quieres una invitación."

#. key: group_invite_not_verified
#, python-brace-format
msgid "You're not currently verified as 18+ in **{server}**, so the invite couldn't be sent. Verify again to get a new invite offer."
msgstr "Actualmente no estás verificado como 18+ en **{server}**, así que no se pudo enviar la invitación. Verifícate de nuevo para recibir una nueva invitación."

#. key: group_invite_sent
#, python-brace-format
msgid "Invite sent! Open your VRChat notifications to join **{group}**."
msgstr "¡Invitación enviada! Abre tus notificaciones de VRChat para unirte a **{group}**."

#. key: group_invite_setup_problem
#, python-brace-format
msgid "**{server}**'s VRChat group isn't set up correctly right now, so the invite couldn't be sent. Please let the server's admins know."
msgstr "El grupo de VRChat de **{server}** no está configurado correctamente ahora mismo, así que no se pudo enviar la invitación. Avisa a los administradores del servidor."

#. key: group_invite_too_soon
msgid "You've already asked for an invite. Please give it a few minutes before trying again."
msgstr "Ya has pedido una invitación. Espera unos minutos antes de volver a intentarlo."

#. key: group_invite_unavailable
msgid "VRChat didn't answer, so the invite couldn't be sent. Please try again in a few minutes."
msgstr "VRChat no respondió, así que no se pudo enviar la invitación. Inténtalo de nuevo en unos minutos."

#. key: group_invite_working
msgid "Asking VRChat for your invite..."
msgstr "Pidiendo tu invitación a VRChat..."

#. key: guild_join_welcome_dm
#, python-brace-format
msgid ""
"👋 Thanks for adding VRCVerify to **{server}**!\n"
"\n"
"To get set up:\n"
"1. Run `/vrcverify_setup` to choose the role members get once verified.\n"
"2. Run `/vrcverify_instructions` in the channel you want members to verify from — use a normal text channel everyone can see, not a thread, since threads auto-archive and quietly break the panel.\n"
"\n"
"Need a hand? `/vrcverify_support` has you covered."
msgstr ""
"👋 ¡Gracias por añadir VRCVerify a **{server}**!\n"
"\n"
"Para configurarlo:\n"
"1. Ejecuta `/vrcverify_setup` para elegir el rol que reciben los miembros al verificarse.\n"
"2. Ejecuta `/vrcverify_instructions` en el canal desde el que quieras que se verifiquen — usa un canal de texto normal que todos puedan ver, no un hilo, ya que los hilos se archivan solos y rompen el panel sin avisar.\n"
"\n"
"¿Necesitas ayuda? `/vrcverify_support` está para eso."

#. key: instructions_desc
msgid ""
"**Follow these steps** to verify your 18+ status:\n"
"\n"
"1. Click the **Begin Verification** button (if shown) or type `/vrcverify` anywhere.\n"
"2. If you're new, you'll be asked for your VRChat username\n"
"3. The bot will give you a unique code - put this in your VRChat bio **ON ITS OWN LINE**\n"
"4. Press **Verify** in Discord once your bio is updated\n"
"\n"
"If you need additional help, contact an admin or type `/vrcverify_support`."
msgstr ""
"**Sigue estos pasos** para verificar tu estado 18+:\n"
"\n"
"1. Haz clic en el botón **Iniciar Verificación** (si se muestra) o escribe `/vrcverify` en cualquier lugar.\n"
"2. Si eres nuevo, se te pedirá tu nombre de usuario de VRChat\n"
"3. El bot te dará un código único - colócalo en tu biografía de VRChat **EN SU PROPIA LÍNEA**\n"
"4. Presiona **Verificar** en Discord una vez que tu biografía esté actualizada\n"
"\n"
"Si necesitas ayuda adicional, contacta a un admin o escribe `/vrcverify_support`."

#. key: instructions_title
msgid "How to Use the VRChat Verification Bot"
msgstr "Cómo usar el bot de verificación de VRChat"

#. key: invalid_vrc_id_input
msgid ""
"It looks like you entered your display name instead of your VRChat userID.\n"
"Please enter either the full profile URL or your userID (which always starts with `usr_`).\n"
"https://imgur.com/a/EEl6ekH"
msgstr ""
"Parece que ingresaste tu nombre para mostrar en lugar de tu ID de usuario de VRChat.\n"
"Por favor, ingresa la URL completa del perfil o tu ID de usuario (que siempre comienza con `usr_`).\n"
"https://imgur.com/a/EEl6ekH"

#. key: log_channel_announcement
#, python-brace-format
msgid "{channel} is an announcement channel. Other servers can follow it, which would republish your members' 18+ status outside this server, so it can't be used as a verification log. Please pick a normal text channel."
msgstr "{channel} es un canal de anuncios. Otros servidores pueden seguirlo, lo que republicaría el estado 18+ de tus miembros fuera de este servidor, así que no puede usarse como registro de verificación. Elige un canal de texto normal."

#. key: log_channel_cleared
msgid "Verification activity logging is now off."
msgstr "El registro de actividad de verificación está desactivado."

#. key: log_channel_no_permission
#, python-brace-format
msgid "I can't post in {channel}. Give the bot **View Channel** and **Send Messages** there, then run this command again."
msgstr "No puedo publicar en {channel}. Dale al bot **Ver canal** y **Enviar mensajes** ahí y vuelve a ejecutar este comando."

#. key: log_channel_premium_only
msgid "The verification activity log is a VRCVerify Premium feature. Core 18+ verification stays free for everyone."
msgstr "El registro de actividad de verificación es una función de VRCVerify Premium. La verificación 18+ sigue siendo gratuita para todos."

#. key: log_channel_ready
msgid ""
"📋 Verification activity will be logged here from now on.\n"
"Entries show the member, the result and the time — never their VRChat name or ID."
msgstr ""
"📋 A partir de ahora la actividad de verificación se registrará aquí.\n"
"Las entradas muestran el miembro, el resultado y la hora, nunca su nombre ni su ID de VRChat."

#. key: log_channel_set
#, python-brace-format
msgid "Verification activity will be logged in {channel}."
msgstr "La actividad de verificación se registrará en {channel}."

#. key: log_entries_dropped
#, python-brace-format
msgid "…{count} earlier entries could not be recorded."
msgstr "…no se pudieron registrar {count} entradas anteriores."

#. key: log_not_18
#, python-brace-format
msgid "❌ {user} — not 18+ according to VRChat · {when}"
msgstr "❌ {user} — no es 18+ según VRChat · {when}"

#. key: log_role_failed
#, python-brace-format
msgid "⚠️ {user} — verified 18+, but the role could not be assigned. Check that the VRCVerify bot's role sits above the verified role. · {when}"
msgstr "⚠️ {user} — verificado 18+, pero no se pudo asignar el rol. Comprueba que el rol del bot VRCVerify esté por encima del rol de verificado. · {when}"

#. key: log_verified
#, python-brace-format
msgid "✅ {user} — verified 18+ · {when}"
msgstr "✅ {user} — verificado 18+ · {when}"

#. key: milestone_owner_dm
#, python-brace-format
msgid ""
"🎉 **{server}** has reached {count} completed verifications with VRCVerify!\n"
"The bot is free and runs on donations — if it's been useful to your community, you can support it here: {kofi_link}\n"
"(This is a one-time message.)"
msgstr ""
"🎉 ¡**{server}** ha alcanzado {count} verificaciones completadas con VRCVerify!\n"
"El bot es gratuito y se mantiene gracias a las donaciones. Si le ha sido útil a tu comunidad, puedes apoyarlo aquí: {kofi_link}\n"
"(Este es un mensaje único.)"

#. key: nickname_update_failed
msgid "We could not update your nickname."
msgstr "No pudimos actualizar tu apodo."

#. key: nickname_update_requested
msgid "Nickname update requested. I'll DM you once it's done!"
msgstr "Solicitud de actualización de apodo enviada. ¡Te enviaré un DM cuando esté listo!"

#. key: nickname_updated
#, python-brace-format
msgid "Your nickname was updated to {display_name}."
msgstr "Tu apodo fue actualizado a {display_name}."

#. key: not_18_plus
msgid "You are not 18+ according to VRChat. Contact an admin if this is an error."
msgstr "No tienes 18+ según VRChat. Contacta a un administrador si esto es un error."

#. key: not_verified
msgid "You haven't verified yet. Please click **Begin Verification** first."
msgstr "Aún no estás verificado. Por favor haz clic en **Iniciar Verificación** primero."

#. key: panel_color_invalid
msgid "That doesn't look like a hex colour. Use something like `#5865F2` (or `#58F` for short)."
msgstr "Eso no parece un color hexadecimal. Usa algo como `#5865F2` (o `#58F` en forma corta)."

#. key: panel_nudge_dm
#, python-brace-format
msgid ""
"👋 You set up VRCVerify in **{server}**, but no instructions panel has been posted yet — so members there still have no way to start verifying.\n"
"\n"
"Run `/vrcverify_instructions` in the channel you want them to verify from. Use a normal text channel everyone can see rather than a thread, since threads auto-archive and quietly break the panel.\n"
"\n"
"Run `/vrcverify_status` in your server for a quick health check.\n"
"(This is a one-time message.)"
msgstr ""
"👋 Configuraste VRCVerify en **{server}**, pero aún no se ha publicado ningún panel de instrucciones, así que los miembros todavía no tienen forma de empezar a verificarse.\n"
"\n"
"Ejecuta `/vrcverify_instructions` en el canal desde el que quieras que se verifiquen. Usa un canal de texto normal que todos puedan ver en lugar de un hilo, ya que los hilos se archivan solos y rompen el panel sin avisar.\n"
"\n"
"Ejecuta `/vrcverify_status` en tu servidor para una comprobación rápida.\n"
"(Este es un mensaje único.)"

#. key: premium_cutover_dm
#, python-brace-format
msgid ""
"👋 A quick heads-up about VRCVerify in **{server}**.\n"
"\n"
"VRCVerify now has an optional Premium tier — and to be clear up front, **nothing about your server changes.**\n"
"\n"
"18+ verification is free and staying free, permanently, for everyone. So is auto-verifying members who are already verified when they join.\n"
"\n"
"And because **{server}** was set up before Premium launched, it keeps these too, at no cost, permanently:\n"
"• Automatic removal of the unverified role\n"
"• Automatic nickname sync with VRChat\n"
"• Custom post-verification message\n"
"\n"
"So there is nothing you need to do. If you're ever curious what Premium adds, run `/vrcverify_subscription` in your server.\n"
"(This is a one-time message.)"
msgstr ""
"👋 Un aviso rápido sobre VRCVerify en **{server}**.\n"
"\n"
"VRCVerify ahora tiene un nivel Premium opcional y, para dejarlo claro desde el principio, **no cambia nada en tu servidor.**\n"
"\n"
"La verificación 18+ es gratuita y seguirá siéndolo, de forma permanente, para todos. También lo es verificar automáticamente a los miembros ya verificados cuando entran.\n"
"\n"
"Y como **{server}** se configuró antes del lanzamiento de Premium, conserva además estas funciones sin coste, de forma permanente:\n"
"• Eliminación automática del rol de no verificado\n"
"• Sincronización automática del apodo con VRChat\n"
"• Mensaje personalizado tras la verificación\n"
"\n"
"Así que no tienes que hacer nada. Si alguna vez te da curiosidad qué añade Premium, ejecuta `/vrcverify_subscription` en tu servidor.\n"
"(Este es un mensaje único.)"

#. key: premium_status_active
#, python-brace-format
msgid ""
"✅ **VRCVerify Premium is active on {server}.**\n"
"\n"
"Unlocked here:\n"
"• Verification activity log — set it up with `/vrcverify_logchannel`\n"
"• Priority in the verification queue when there's a backlog\n"
"• Automatic removal of the unverified role\n"
"• Automatic nickname sync with VRChat\n"
"• Custom post-verification message\n"
"• Your colour and server icon on the instructions panel\n"
"• Reduced verification cooldown\n"
"• Invite verified members straight into your server's VRChat group\n"
"\n"
"Appearance and automation settings live in `/vrcverify_settings`.\n"
"\n"
"You can manage or cancel this any time from Discord's **User Settings → Subscriptions**.\n"
"Thank you for supporting VRCVerify. 💜"
msgstr ""
"✅ **VRCVerify Premium está activo en {server}.**\n"
"\n"
"Desbloqueado aquí:\n"
"• Registro de actividad de verificación — configúralo con `/vrcverify_logchannel`\n"
"• Prioridad en la cola de verificación cuando hay retraso\n"
"• Eliminación automática del rol de no verificado\n"
"• Sincronización automática del apodo con VRChat\n"
"• Mensaje personalizado tras la verificación\n"
"• Tu color y el icono de tu servidor en el mensaje de instrucciones\n"
"• Tiempo de espera de verificación reducido\n"
"• Invita a los miembros verificados directamente al grupo de VRChat de tu servidor\n"
"\n"
"Los ajustes de apariencia y automatización están en `/vrcverify_settings`.\n"
"\n"
"Puedes gestionarlo o cancelarlo cuando quieras desde **Ajustes de usuario → Suscripciones** en Discord.\n"
"Gracias por apoyar a VRCVerify. 💜"

#. key: premium_status_active_both
#, python-brace-format
msgid ""
"⚠️ **{server} is paying for VRCVerify Premium twice.**\n"
"\n"
"There's an active **Discord** subscription and an active **card** subscription for this server. Premium is on and stays on — but you're being charged for both.\n"
"\n"
"Nothing has been cancelled for you, deliberately: cancelling a subscription and issuing a refund without a person deciding is not something this bot should do on its own.\n"
"\n"
"Keep whichever suits you and cancel the other:\n"
"• **Discord** — User Settings → Subscriptions\n"
"• **Card** — the Subscriptions page on the website\n"
"\n"
"If you're unsure: the website has 6- and 12-month plans that work out cheaper, and Discord can only bill monthly."
msgstr ""
"⚠️ **{server} está pagando VRCVerify Premium dos veces.**\n"
"\n"
"Hay una suscripción activa de **Discord** y otra de **tarjeta** para este servidor. Premium sigue activo — pero se te está cobrando por ambas.\n"
"\n"
"No hemos cancelado nada por ti, a propósito: cancelar una suscripción y emitir un reembolso sin que lo decida una persona no es algo que este bot deba hacer por su cuenta.\n"
"\n"
"Quédate con la que prefieras y cancela la otra:\n"
"• **Discord** — Ajustes de usuario → Suscripciones\n"
"• **Tarjeta** — la página de Suscripciones en la web\n"
"\n"
"Si no lo tienes claro: la web tiene planes de 6 y 12 meses más baratos, y Discord solo puede facturar mensualmente."

#. key: premium_status_active_card
#, python-brace-format
msgid ""
"✅ **VRCVerify Premium is active on {server}.**\n"
"\n"
"Unlocked here:\n"
"• Verification activity log — set it up with `/vrcverify_logchannel`\n"
"• Priority in the verification queue when there's a backlog\n"
"• Automatic removal of the unverified role\n"
"• Automatic nickname sync with VRChat\n"
"• Custom post-verification message\n"
"• Your colour and server icon on the instructions panel\n"
"• Reduced verification cooldown\n"
"• Invite verified members straight into your server's VRChat group\n"
"\n"
"Appearance and automation settings live in `/vrcverify_settings`.\n"
"\n"
"This server pays by card, so manage or cancel it on the **VRCVerify website** — it won't appear in Discord's subscription settings.\n"
"Thank you for supporting VRCVerify. 💜"
msgstr ""
"✅ **VRCVerify Premium está activo en {server}.**\n"
"\n"
"Desbloqueado aquí:\n"
"• Registro de actividad de verificación — configúralo con `/vrcverify_logchannel`\n"
"• Prioridad en la cola de verificación cuando hay retraso\n"
"• Eliminación automática del rol de no verificado\n"
"• Sincronización automática del apodo con VRChat\n"
"• Mensaje personalizado tras la verificación\n"
"• Tu color y el icono de tu servidor en el mensaje de instrucciones\n"
"• Tiempo de espera de verificación reducido\n"
"• Invita a los miembros verificados directamente al grupo de VRChat de tu servidor\n"
"\n"
"Los ajustes de apariencia y automatización están en `/vrcverify_settings`.\n"
"\n"
"Este servidor paga con tarjeta, así que gestiónalo o cancélalo en la **web de VRCVerify**: no aparecerá en los ajustes de suscripciones de Discord.\n"
"Gracias por apoyar a VRCVerify. 💜"

#. key: premium_status_grandfathered
#, python-brace-format
msgid ""
"**18+ verification is free on {server}, and always will be.** So is auto-verifying members who are already verified when they join.\n"
"\n"
"Because this server was set up before Premium launched, it also keeps these for free, permanently:\n"
"• Automatic removal of the unverified role\n"
"• Automatic nickname sync with VRChat\n"
"• Custom post-verification message\n"
"\n"
"Premium adds these on top:\n"
"• Verification activity log — every verification in a channel you choose, including the ones that fail silently\n"
"• Priority in the verification queue when there's a backlog\n"
"• Your colour and server icon on the instructions panel\n"
"• Reduced verification cooldown\n"
"• Invite verified members straight into your server's VRChat group\n"
"\n"
"**Premium is available two ways:**\n"
"• **In Discord** — the button below. Billed monthly.\n"
"• **By card on the website** — the same Premium, plus 6- and 12-month plans that work out cheaper. Discord can only bill monthly, so the longer plans are website-only."
msgstr ""
"**La verificación 18+ es gratuita en {server}, y siempre lo será.** También lo es verificar automáticamente a los miembros ya verificados cuando entran.\n"
"\n"
"Como este servidor se configuró antes del lanzamiento de Premium, además conserva estas funciones gratis, de forma permanente:\n"
"• Eliminación automática del rol de no verificado\n"
"• Sincronización automática del apodo con VRChat\n"
"• Mensaje personalizado tras la verificación\n"
"\n"
"Premium añade esto por encima:\n"
"• Registro de actividad de verificación: cada verificación en un canal que elijas, incluidas las que fallan en silencio\n"
"• Prioridad en la cola de verificación cuando hay retraso\n"
"• Tu color y el icono de tu servidor en el mensaje de instrucciones\n"
"• Tiempo de espera de verificación reducido\n"
"• Invita a los miembros verificados directamente al grupo de VRChat de tu servidor\n"
"\n"
"**Puedes conseguir Premium de dos formas:**\n"
"• **En Discord** — el botón de abajo. Facturación mensual.\n"
"• **Con tarjeta en la web** — el mismo Premium, más planes de 6 y 12 meses que salen más baratos. Discord solo puede facturar mensualmente, así que los planes largos son exclusivos de la web."

#. key: premium_status_inactive
#, python-brace-format
msgid ""
"**18+ verification is free on {server}, and always will be.** So is auto-verifying members who are already verified when they join.\n"
"\n"
"VRCVerify Premium adds these optional extras for this server:\n"
"• Verification activity log — every verification in a channel you choose, including the ones that fail silently\n"
"• Priority in the verification queue when there's a backlog\n"
"• Automatic removal of the unverified role\n"
"• Automatic nickname sync with VRChat\n"
"• Custom post-verification message\n"
"• Your colour and server icon on the instructions panel\n"
"• Reduced verification cooldown\n"
"• Invite verified members straight into your server's VRChat group\n"
"\n"
"One subscription covers the whole server, and there are two ways to buy it:\n"
"• **In Discord** — the button below. Billed monthly.\n"
"• **By card on the website** — the same Premium, plus 6- and 12-month plans that work out cheaper. Discord can only bill monthly, so the longer plans are website-only."
msgstr ""
"**La verificación 18+ es gratuita en {server}, y siempre lo será.** También lo es verificar automáticamente a los miembros ya verificados cuando entran.\n"
"\n"
"VRCVerify Premium añade estos extras opcionales para este servidor:\n"
"• Registro de actividad de verificación: cada verificación en un canal que elijas, incluidas las que fallan en silencio\n"
"• Prioridad en la cola de verificación cuando hay retraso\n"
"• Eliminación automática del rol de no verificado\n"
"• Sincronización automática del apodo con VRChat\n"
"• Mensaje personalizado tras la verificación\n"
"• Tu color y el icono de tu servidor en el mensaje de instrucciones\n"
"• Tiempo de espera de verificación reducido\n"
"• Invita a los miembros verificados directamente al grupo de VRChat de tu servidor\n"
"\n"
"Una sola suscripción cubre todo el servidor, y hay dos formas de contratarla:\n"
"• **En Discord** — el botón de abajo. Facturación mensual.\n"
"• **Con tarjeta en la web** — el mismo Premium, más planes de 6 y 12 meses que salen más baratos. Discord solo puede facturar mensualmente, así que los planes largos son exclusivos de la web."

#. key: recheck_started
msgid "We're re-checking your VRChat 18+ status. If you've updated your VRChat age verification, you'll get a DM soon!"
msgstr "Estamos revisando de nuevo tu estado 18+. Si has actualizado tu verificación de edad, ¡recibirás un DM pronto!"

#. key: settings_intro
#, python-brace-format
msgid ""
"**VRChat Verify Settings**\n"
"\n"
"1.) **Enable auto nickname change**\n"
"   Automatically update users' Discord nicknames to match their VRChat display names.\n"
"   Current: **{current}**"
msgstr ""
"**Configuración de Verificación VRChat**\n"
"\n"
"1.) **Habilitar cambio automático de apodo**\n"
"   Actualiza automáticamente los apodos de Discord de los usuarios para que coincidan con sus nombres de pantalla de VRChat.\n"
"   Actual: **{current}**"

#. key: settings_saved
msgid "Settings saved!"
msgstr "¡Configuración guardada!"

#. key: settings_unreadable
msgid "Couldn't read this server's settings just now. Try again shortly — nothing has changed."
msgstr "No se pudieron leer los ajustes de este servidor ahora mismo. Inténtalo de nuevo en un momento: no se ha cambiado nada."

#. key: setup_donate_hint
#, python-brace-format
msgid ""
"\n"
"\n"
"☕ VRCVerify is free thanks to donations. If it helps your community, you can support it here: {kofi_link}"
msgstr ""
"\n"
"\n"
"☕ VRCVerify es gratuito gracias a las donaciones. Si ayuda a tu comunidad, puedes apoyarlo aquí: {kofi_link}"

#. key: setup_missing
msgid "This server hasn't set up a verification role yet. Please contact an admin."
msgstr "Este servidor aún no ha configurado un rol de verificación. Por favor, contacta a un administrador."

#. key: setup_panel_nudge
msgid ""
"\n"
"\n"
"📌 **One more step:** members can't verify until you post the instructions panel.\n"
"Run `/vrcverify_instructions` in the channel you want them to verify from. Use a normal text channel everyone can see — not a thread, since threads auto-archive and quietly break the panel.\n"
"You can run `/vrcverify_status` any time to check on it."
msgstr ""
"\n"
"\n"
"📌 **Un paso más:** los miembros no pueden verificarse hasta que publiques el panel de instrucciones.\n"
"Ejecuta `/vrcverify_instructions` en el canal desde el que quieras que se verifiquen. Usa un canal de texto normal que todos puedan ver, no un hilo, ya que los hilos se archivan solos y rompen el panel sin avisar.\n"
"Puedes ejecutar `/vrcverify_status` cuando quieras para comprobarlo."

#. key: setup_success
#, python-brace-format
msgid ""
"Successfully {action} server config.\n"
"Verified Role set to: `{role}` (ID={role_id})"
msgstr ""
"Configuración del servidor {action}.\n"
"Rol verificado establecido en: `{role}` (ID={role_id})"

#. key: setup_unverified_missing
msgid ""
"\n"
"(Unverified role not set; no role will be removed on verification.)"
msgstr ""
"\n"
"(Rol no verificado no configurado; no se eliminará ningún rol al verificar.)"

#. key: setup_unverified_set
#, python-brace-format
msgid ""
"\n"
"Unverified Role to remove: `{role}` (ID={role_id})"
msgstr ""
"\n"
"Rol no verificado a eliminar: `{role}` (ID={role_id})"

#. key: status_header
#, python-brace-format
msgid "**VRCVerify status for {server}**"
msgstr "**Estado de VRCVerify en {server}**"

#. key: status_panel_archived
msgid "⚠️ The instructions panel is in a thread that has been archived, so the bot can't update it. Un-archive the thread, or post a fresh panel in a normal text channel."
msgstr "⚠️ El panel de instrucciones está en un hilo que se ha archivado, así que el bot no puede actualizarlo. Desarchiva el hilo o publica un panel nuevo en un canal de texto normal."

#. key: status_panel_gone
msgid "❌ The saved instructions panel no longer exists — it or its channel was deleted. Run `/vrcverify_instructions` again to post a new one."
msgstr "❌ El panel de instrucciones guardado ya no existe: se eliminó él o su canal. Ejecuta `/vrcverify_instructions` de nuevo para publicar uno nuevo."

#. key: status_panel_missing
msgid "❌ No instructions panel posted — run `/vrcverify_instructions` in the channel members should verify from."
msgstr "❌ No hay ningún panel de instrucciones publicado: ejecuta `/vrcverify_instructions` en el canal donde los miembros deban verificarse."

#. key: status_panel_ok
msgid "✅ Instructions panel is posted and the bot can still update it."
msgstr "✅ El panel de instrucciones está publicado y el bot aún puede actualizarlo."

#. key: status_panel_unreachable
msgid "⚠️ The instructions panel exists but the bot can't update it. Check that it still has **View Channel**, **Send Messages** and **Embed Links** in that channel."
msgstr "⚠️ El panel de instrucciones existe, pero el bot no puede actualizarlo. Comprueba que sigue teniendo **Ver canal**, **Enviar mensajes** e **Insertar enlaces** en ese canal."

#. key: status_role_deleted
msgid "❌ The configured verified role no longer exists — run `/vrcverify_setup` to pick a new one."
msgstr "❌ El rol de verificado configurado ya no existe: ejecuta `/vrcverify_setup` para elegir uno nuevo."

#. key: status_role_missing
msgid "❌ No verified role set — run `/vrcverify_setup` to choose one."
msgstr "❌ No hay ningún rol de verificado configurado: ejecuta `/vrcverify_setup` para elegir uno."

#. key: status_role_ok
#, python-brace-format
msgid "✅ Verified role: **{role}**"
msgstr "✅ Rol de verificado: **{role}**"

#. key: status_tips
msgid ""
"\n"
"**Tips**\n"
"• Post the panel in a normal text channel everyone can see — threads auto-archive and silently break it.\n"
"• Keep the bot's **View Channel**, **Send Messages** and **Embed Links** permissions in that channel.\n"
"• If you delete or recreate that channel, run `/vrcverify_instructions` again."
msgstr ""
"\n"
"**Consejos**\n"
"• Publica el panel en un canal de texto normal que todos puedan ver: los hilos se archivan solos y lo rompen en silencio.\n"
"• Mantén los permisos **Ver canal**, **Enviar mensajes** e **Insertar enlaces** del bot en ese canal.\n"
"• Si eliminas o vuelves a crear ese canal, ejecuta `/vrcverify_instructions` otra vez."

#. key: subscription_info
#, python-brace-format
msgid "I've decided to offer this free of charge however if you wish to still support me, you can find my Ko-fi here:{kofi_link}. Thank you for your continued support"
msgstr "He decidido ofrecer esto de forma gratuita, pero si deseas apoyarme, puedes encontrar mi Ko-fi aquí:{kofi_link}. ¡Gracias por tu continuo apoyo!"

#. key: support_info
msgid ""
"Need help with verification?\n"
"- Contact a server admin for assistance\n"
"- Or visit our support page at https://esattotech.com/contact-us/\n"
"\n"
"If this is an error, please let us know!"
msgstr ""
"¿Necesitas ayuda con la verificación?\n"
"- Contacta a un administrador del servidor para asistencia\n"
"- O visita nuestra página de soporte en https://esattotech.com/contact-us/\n"
"\n"
"¡Si esto es un error, háznoslo saber!"

#. key: support_invite_line
#, python-brace-format
msgid "Get VRCVerify updates in your own server: join {invite} and follow the announcements channel."
msgstr "Recibe novedades de VRCVerify en tu propio servidor: únete a {invite} y sigue el canal de anuncios."

#. key: verification_requested
msgid "Verification request received! We'll DM you with the results. Please make sure your DMs for this server are open so you can receive the message."
msgstr "¡Solicitud de verificación recibida! Te enviaremos un DM con los resultados. Asegúrate de tener los DMs abiertos para este servidor."

#. key: verify_button_expired
msgid "This verification link has expired or was replaced by a newer one. Please run `/vrcverify` again to get a fresh code."
msgstr "Este enlace de verificación ha caducado o fue reemplazado por uno más reciente. Por favor, ejecuta `/vrcverify` de nuevo para obtener un código nuevo."

#. key: vrc_id_already_linked
msgid "The VRChat profile you tried to use is already registered to a different Discord account. If you believe this is a mistake, please contact a server admin."
msgstr "El perfil de VRChat que intentaste usar ya está registrado a otra cuenta de Discord. Si crees que se trata de un error, por favor contacta a un administrador del servidor."

#. key: vrchat_issue_outage_confirmed
#, python-brace-format
msgid ""
"VRChat is currently reporting a service issue that is affecting verification. Please try again later.\n"
"\n"
"Status page: {status_page}"
msgstr ""
"VRChat está informando actualmente de un problema de servicio que está afectando a la verificación. Inténtalo de nuevo más tarde.\n"
"\n"
"Página de estado: {status_page}"

#. key: vrchat_issue_outage_confirmed_with_status
#, python-brace-format
msgid ""
"VRChat is currently reporting a service issue that is affecting verification. Please try again later.\n"
"\n"
"Status page: {status_page}\n"
"\n"
"Reported status: {status_message}"
msgstr ""
"VRChat está informando actualmente de un problema de servicio que está afectando a la verificación. Inténtalo de nuevo más tarde.\n"
"\n"
"Página de estado: {status_page}\n"
"\n"
"Estado informado: {status_message}"

#. key: vrchat_issue_outage_suspected
#, python-brace-format
msgid ""
"VRChat appears to be having temporary API issues, so verification could not be completed right now. Please try again later.\n"
"\n"
"Status page: {status_page}"
msgstr ""
"Parece que VRChat está teniendo problemas temporales con la API, por lo que la verificación no pudo completarse en este momento. Inténtalo de nuevo más tarde.\n"
"\n"
"Página de estado: {status_page}"

#. key: vrchat_issue_rate_limited
msgid "VRChat is rate limiting verification lookups right now. Please wait a minute and try again."
msgstr "VRChat está limitando las consultas de verificación en este momento. Espera un minuto y vuelve a intentarlo."

#. key: vrchat_issue_temp_unavailable
msgid "VRCVerify is temporarily unable to talk to VRChat right now. Please try again in a little while."
msgstr "VRCVerify no puede comunicarse con VRChat temporalmente en este momento. Inténtalo de nuevo dentro de un rato."

#. key: vrchat_issue_unexpected
msgid "Verification could not be completed because VRChat returned an unexpected error. Please try again later."
msgstr "La verificación no pudo completarse porque VRChat devolvió un error inesperado. Inténtalo de nuevo más tarde."

#. key: vrchat_issue_user_not_found
msgid "We could not find that VRChat account. Please double-check that you pasted your VRChat profile URL or `usr_...` user ID correctly."
msgstr "No pudimos encontrar esa cuenta de VRChat. Comprueba que hayas pegado correctamente la URL del perfil de VRChat o el ID de usuario `usr_...`."


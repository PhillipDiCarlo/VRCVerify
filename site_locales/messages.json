 ],
 "<0>VRChat</0> — asked whether an account is age verified.": [
  "privacy.html"
 ],
 "<0>We do not offer refunds on card subscriptions</0>, including part-used periods and including where a server stopped using the bot partway through a period.": [
  "refunds.html"
 ],
 "<0>We do not perform age verification ourselves.</0> VRChat does. VRCVerify reads the result VRChat reports and acts on it. We do not handle identity documents, and we cannot vouch for the accuracy of VRChat's determination, the honesty of the person who made it, or whether the VRChat account belongs to the person using the Discord account beyond the code check described in the Privacy Policy.": [
  "terms.html"
 ],

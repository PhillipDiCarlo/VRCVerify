# Copy this file to `.env` (gitignored) and fill in real values.
# Both src/bot.py and src/vrc_online_checker.py load it via python-dotenv.
#
# ---------------------------------------------------------------------------
# NO VALUE HERE MAY CONTAIN A LITERAL `$`. Not in a password, not anywhere.
# ---------------------------------------------------------------------------
# Docker Compose performs variable substitution on these values -- yes, even
# for env_file, despite what older documentation suggests -- so `$z` is
# replaced with the (usually empty) value of a variable named `z` and the
# secret silently arrives shorter than it was written.
#
# This is not hypothetical: on 2026-08-19 a VRChat password containing `$f` and
# `$z` reached its container as 22 characters instead of 25, and the service
# spent an hour failing with "Invalid Username/Email or Password" -- an error
# indistinguishable from simply having the wrong password.
#
# Neither kind of quote helps. Interpolation happens after YAML parsing, on the
# resulting string, so "x$zy" and 'x$zy' are both eaten:
#
#     in this file      Compose gives      python-dotenv gives
#     x$zy              x                  x$zy
#     x$$zy             x$zy               x$$zy      <-- note
#     "x$zy"            x                  x$zy
#
# And `$$` is not an escape hatch, because these files are ALSO read directly
# by python-dotenv whenever a service or script runs outside Docker, and it
# does not unescape `$$`. There is no spelling that satisfies both readers.
#
# So: generate secrets without `$`. If a third party issues you one containing
# `$`, rotate it rather than trying to escape it.

# --- Discord (bot.py) ---
DISCORD_BOT_TOKEN=your-discord-bot-token

# --- Database (bot.py) ---
# PostgreSQL in production; sqlite works for quick local runs:
#   sqlite:///local_test.db
DATABASE_URL=postgresql://user:password@host:5432/vrcverify

# --- RabbitMQ (both services) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_NAME=verification_requests
RABBITMQ_RESULT_QUEUE=verification_results
# NOTE: the request queue is declared with x-max-priority so premium servers are
# served first when a backlog forms. The priority ceiling is a constant in both
# src/bot.py and src/vrc_online_checker.py, NOT an env var -- the two must match
# exactly or every declare fails with 406 and both services stop.
# Upgrading from a build without it requires deleting and recreating the queue
# named by RABBITMQ_QUEUE_NAME above (whatever you have set it to -- not the
# placeholder here). See "Upgrading to a build with queue priority" in the README.
# Connection tuning, so a stale connection is detected instead of hanging.
# RABBITMQ_HEARTBEAT=60
# RABBITMQ_BLOCKED_TIMEOUT=60
# RABBITMQ_CONN_ATTEMPTS=3
# RABBITMQ_RETRY_DELAY=2
# RABBITMQ_SOCKET_TIMEOUT=10
# Retries for a single publish before giving up (bot.py).
# RABBITMQ_PUBLISH_TRIES=3

# --- VRChat account (vrc_online_checker.py) ---
VRCHAT_USERNAME=your-vrchat-username
VRCHAT_PASSWORD=your-vrchat-password

# --- Gmail IMAP for VRChat 2FA codes (vrc_online_checker.py) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Group-invite bot: second VRChat account (issue #49) ---
# A deliberately separate VRChat account from the one above. It is the account
# that joins each server's VRChat group and sends invites, kept apart so that
# moderation action against one cannot take the other down.
#
# Its 2FA email MUST arrive in a different mailbox than GMAIL_USER above. The
# 2FA fetcher searches for the newest mail from noreply@vrchat.com without
# filtering by recipient, so two accounts sharing one inbox would race for each
# other's codes -- and fail silently, burning retries against an endpoint
# VRChat rate-limits.
#
# Unset = the invite worker does not start, and nothing else changes.
# INVITE_VRCHAT_USERNAME=your-invite-bot-vrchat-username
# INVITE_VRCHAT_PASSWORD=your-invite-bot-vrchat-password
# INVITE_GMAIL_USER=invite-bot@gmail.com
# INVITE_GMAIL_APP_PASSWORD=your-invite-bot-gmail-app-password
# The invite bot's own usr_ id, shown on the dashboard so admins invite the
# right account -- VRChat display names are not unique.
# INVITE_VRCHAT_USER_ID=usr_00000000-0000-0000-0000-000000000000
# Its cookie store. MUST NOT be the same path as VRCHAT_SESSION_FILE: two
# accounts sharing one file overwrite each other's auth cookie and thrash.
# INVITE_VRCHAT_SESSION_FILE=/data/vrchat_invite_session.txt
# Queue the bot publishes invite/verify jobs to. Its own queue, not the
# verification queue: two consumers on one queue split messages round-robin,
# so the age checker would swallow invite jobs.
# RABBITMQ_GROUP_INVITE_QUEUE=vrcverify_group_invites
# Where the worker publishes each job's outcome for the bot to persist.
# RABBITMQ_GROUP_INVITE_RESULT_QUEUE=vrcverify_group_invite_results

# How long the dashboard waits for the invite worker to answer a group setup
# check before it stops saying "checking" and reports that nothing came back.
# The round trip is a queue hop each way plus a couple of VRChat calls, so a
# few seconds is normal and two minutes means the worker is down or was never
# deployed.
# GROUP_VERIFY_TIMEOUT_SECONDS=120

# The same idea for ONE member's invite: how long they watch "asking VRChat"
# before being told it did not work. Shorter than the setup check, because an
# invite is two API calls at most while a setup check can include a join.
# GROUP_INVITE_TIMEOUT_SECONDS=90

# Minimum gap between two invite attempts by the SAME member for the same
# group. Nothing to do with the settled outcomes -- being in the group, or
# having said no, is permanent and needs no timer. This bounds retries after a
# transient failure, where the member gets their button back.
# GROUP_INVITE_COOLDOWN_SECONDS=300

# --- Issue #49 phase 6: invite-account seats ---
# A VRChat account can be in 100 groups, 200 with VRC+. That cap is the
# scarcest thing the group-invite feature has, so it is accounted for.
#
# The roster. Format: usr_id|queue|seats per entry, seats optional, entries
# comma-separated. LEAVE THIS UNSET while you run one invite account -- the bot
# builds a one-entry roster from INVITE_VRCHAT_USER_ID and
# RABBITMQ_GROUP_INVITE_QUEUE, so nothing changes for an existing deployment.
#
# Each account needs its own queue, and its own vrc-group-inviter service with
# its own INVITE_VRCHAT_* credentials. Two workers sharing one queue get each
# other's jobs, which means inviting people to groups the account never joined.
#
# INVITE_ACCOUNTS=usr_aaa|vrcverify_group_invites|200,usr_bbb|vrcverify_group_invites_2|100
#
# The compose files carry a commented-out `vrc-group-inviter-2` service for
# exactly this. It reads the `_2`-suffixed variables below, which exist only to
# keep the second account's credentials distinct in this file -- the worker
# itself always reads the unsuffixed names, because each container runs exactly
# one account.
# INVITE_VRCHAT_USER_ID_2=usr_...
# INVITE_VRCHAT_USERNAME_2=
# INVITE_VRCHAT_PASSWORD_2=
# INVITE_GMAIL_USER_2=
# INVITE_GMAIL_APP_PASSWORD_2=
# RABBITMQ_GROUP_INVITE_QUEUE_2=vrcverify_group_invites_2
#
# Default seat cap for an entry that does not name one. Raise to 200 for an
# account with VRC+.
# INVITE_ACCOUNT_SEAT_CAP=100
#
# How long a server may go without a subscription before the bot leaves its
# VRChat group and the seat goes back in the pool. 90 days. Their configuration
# survives: group id, claim code and verified_at are all kept, so coming back
# is "invite the bot again and press check" rather than a full re-setup.
# SEAT_LAPSE_GRACE_SECONDS=7776000
#
# A seat promised to an admin who then never finished setting up. 30 days.
# SEAT_RESERVATION_GRACE_SECONDS=2592000
#
# Log a warning once this many seats or fewer remain across the whole roster.
# SEAT_CAPACITY_WARN_FREE=10
#
# The sweep that does the reclaiming. Its interval does not decide how promptly
# a seat comes back -- the grace period does -- so this is really about how
# fresh the capacity warning is.
# SEAT_SWEEP_INTERVAL=21600
# SEAT_SWEEP_MAX_PER_PASS=25
# SEAT_SWEEP_SPACING=2

# Minimum gap between two invites the WORKER sends, to anyone, with jitter on
# top (vrc_group_inviter.py). One account issues invites for every guild, so
# throughput is a shared budget: a server running a verification drive must
# not be able to spend it in a burst. 429 plus backoff would shape this
# eventually, but only after VRChat has already seen the burst -- and a lot of
# group invites very fast from one account is precisely what the Creator
# Guidelines describe as abuse. Raise it if the invite account is ever rate
# limited; lower it only with a reason.
# INVITE_MIN_SPACING_SECONDS=3
#
# How many times one VRChat call is retried when the failure is transient
# (429, 500, 502, 503, 504). Each retry backs off with jitter.
# INVITE_CALL_RETRIES=3
#
# The invite worker's RabbitMQ heartbeat, deliberately longer than the other
# two services'. VRChat work runs inline on the consumer thread and pika cannot
# send heartbeats from inside the callback, so a job doing several retried call
# chains can outlast the usual window -- at which point the broker drops the
# connection, the ack fails, and the job is redelivered and re-run.
# RABBITMQ_HEARTBEAT_INVITER=300

# --- Where the web dashboard lives (bot.py) ---
# Must include the scheme (https://...), base URL only, no trailing path. A
# value without a scheme is refused and logged rather than sent to Discord,
# which rejects a link button built from one and fails the whole command.
#
# Configuring settings happens on the dashboard now. /vrcverify_settings,
# /vrcverify_logchannel and /vrcverify_setrequestmessage show what is stored
# and link here instead of editing.
#
# WITHOUT THIS SET, THE BOT STILL VERIFIES BUT CANNOT BE RECONFIGURED.
# The commands above keep answering -- same read-only summary, no button on the
# end -- and /vrcverify_setup and /vrcverify_status never needed it. But the
# settings those commands used to change have no other editor, so leaving this
# unset means:
#
#   * an already-configured verification log channel cannot be turned off, and
#     every entry in it pairs a named member with their 18+ status
#   * the instructions language, nickname sync, custom verification message,
#     panel branding and auto-verify-on-join are fixed at whatever they are
#
# /vrcverify_setup still sets the verified role, so a fresh install with no
# dashboard works. It is reconfiguring afterwards that needs one.
# DASHBOARD_URL=https://dashboard.vrcverify.com

# --- Premium tier: Discord App Subscriptions (bot.py) ---
# The guild-subscription SKU id from Developer Portal -> Monetization.
#
# THIS IS THE KILL SWITCH. Leave it unset and premium gating is entirely
# inert -- every server behaves exactly like the free bot did. Set it and the
# gates come alive, no redeploy needed. Unset it again to roll the tier back.
#
# Note Discord subscription SKUs bill monthly only; there is no annual option.
# PREMIUM_SKU_ID=1234567890123456789
# Seconds a resolved entitlement is trusted before re-checking with Discord
# (default 900). Purchases don't wait for this -- the entitlement gateway
# events invalidate the guild immediately. This only bounds a *missed* event.
# PREMIUM_STATUS_TTL=900
# How long a FAILED entitlement lookup is cached (default 60). Deliberately
# much shorter than the success TTL: a Discord outage must not lock a paying
# server out of its features for the full window.
# PREMIUM_FAILURE_TTL=60
# Per-user cooldown for subscribed servers (default 3). 0 removes the wait.
# PREMIUM_VERIFICATION_COOLDOWN_SECONDS=3
# The grandfather line: servers whose `servers.id` is <= it keep unverified-role
# removal, nickname sync and the custom DM for free, forever. (Auto-verify-on-
# join is free for every server and isn't affected by this.)
#
# LEAVE THIS UNSET. The line is not configured -- it is captured automatically
# into the premium_grandfather_line table on the first startup that finds
# PREMIUM_SKU_ID set, and holds MAX(servers.id) as of that moment. So every
# server installed before you switch the tier on is grandfathered, and only
# servers added afterwards are ever asked to pay for those three features.
# Nobody can lose automation they already had.
#
# Setting this overrides that capture, which is almost never what you want.
# It exists as an escape hatch if a capture goes wrong.
# PREMIUM_GRANDFATHER_MAX_ID=
# One-time cutover announcement to every server that predates the tier.
# Nothing is sent until this file appears; `touch` it when you're ready, and
# the campaign trickles out and then stops on its own.
# PREMIUM_CUTOVER_TRIGGER_PATH=/tmp/premium_cutover.trigger
# Sweep interval, per-sweep cap, and seconds between sends. Same reasoning as
# the panel nudge: a DM blast across hundreds of servers is what Discord's
# anti-spam heuristics look for.
# PREMIUM_CUTOVER_INTERVAL=300
# PREMIUM_CUTOVER_MAX_PER_SWEEP=20
# PREMIUM_CUTOVER_DM_SPACING=2.0
# Give up after this many consecutive failed sweeps, so a DB outage can't
# wedge the trigger watcher for the life of the process (default 3).
# PREMIUM_CUTOVER_MAX_FAILURES=3

# --- Premium tier: card subscriptions via Stripe (bot.py) ---
# The second way to buy the identical premium bundle. Premium is granted if
# EITHER source is live -- a Discord entitlement, or an active card
# subscription. Never one overriding the other.
#
# THIS IS THE KILL SWITCH, and it is the bot's own copy of it. Leave it unset
# and the bot never reads the stripe_subscription table, never registers the
# API route that writes it, and tells the dashboard there is no card option --
# so this code ships and runs with behaviour identical to before.
#
# The dashboard has its own STRIPE_ENABLED, which gates the Stripe secrets and
# the checkout buttons. They are not redundant, and the order matters: turn
# THIS one on first. With the dashboard's on and this one off, a customer
# completes checkout, is charged, Stripe's webhook is answered 404 for three
# days and then gives up, and premium never switches on. See VPS_RUNBOOK.md.
#
# The bot holds no Stripe credential of any kind, switched on or off. It reads
# a table the dashboard fills in over mTLS, and that is the whole integration.
# STRIPE_ENABLED=1
# Seconds a resolved card subscription is trusted before re-reading the table
# (default 900). Purchases don't wait for this either -- the webhook write
# invalidates the guild in the same process. This only bounds a *missed*
# webhook.
# STRIPE_STATUS_TTL=900
# How long processed Stripe event ids are kept for replay protection, in days
# (default 30). Pruned by the function that inserts them, so there is no sweep
# to fail; Stripe retries a webhook for at most three days, so this is already
# an order of magnitude more than replay protection needs.
# STRIPE_EVENT_RETENTION_DAYS=30

# How many entitlements the startup sweep will walk (default 2000).
#
# The sweep records every guild Discord has ever issued the premium SKU to,
# ENDED entitlements included, because that is what the free trial's
# "has this server ever paid" question needs and the gateway only reports
# changes that happen while the bot is connected. It runs on every boot;
# inserts are idempotent, so repeating it is what closes a gap left by
# downtime.
#
# Raise it before the number of lifetime subscribers reaches it. Past the cap
# the sweep logs an explicit error and stops -- the ledger is then INCOMPLETE
# and a server beyond the cap can be offered a second free trial. Nothing else
# breaks, which is exactly why the log line is worth reading after a deploy.
# ENTITLEMENT_SWEEP_MAX=2000

# Verification activity log. Entries are buffered and posted in batches, not
# one message per verification: Discord allows ~5 messages per 5s per channel
# and that budget is shared with verification DMs and command replies.
# Seconds between flushes (default 5).
# VERIFICATION_LOG_FLUSH_INTERVAL=5
# Log messages started per second across all guilds during a flush (default 5).
# VERIFICATION_LOG_RATE=5
# Entries held for one guild between flushes (default 200). Reached only when
# a channel is unreachable or a verification drive outruns the flush; beyond
# it the oldest are dropped and the next batch says how many.
# VERIFICATION_LOG_MAX_BUFFERED=200

# --- Optional ---
LOG_LEVEL=INFO
# VRCHAT_API_CONNECT_TIMEOUT_SECONDS=10
# VRCHAT_API_READ_TIMEOUT_SECONDS=20
# VRCHAT_RELOGIN_INTERVAL_SECONDS=600
# Persist the VRChat auth cookie so restarts skip re-authentication (each
# fresh login burns a 2FA email and VRChat rate-limits that endpoint).
# This file IS a credential: written 0600, keep it off shared storage.
# Unset = disabled. Compose defaults it to /data on a named volume.
# VRCHAT_SESSION_FILE=/data/vrchat_session.txt
# Read bios from VRChat's newer /profile/{id} endpoint (default true).
# /users/{id} can serve a stale bio and break verification; set false to revert.
# VRCHAT_USE_PROFILE_ENDPOINT=true
# INSTRUCTIONS_TRIGGER_PATH=/tmp/update_instructions.trigger
# How often that file is checked, in seconds.
# INSTRUCTIONS_TRIGGER_POLL=5
# How many instruction panels are re-attached at once on startup (default 10).
# INSTRUCTIONS_REFRESH_CONCURRENCY=10
# Panel edits started per second (default 25). Discord's global ceiling is ~50
# req/s for the whole bot, so keep headroom here or startup will throttle
# verification traffic too.
# INSTRUCTIONS_REFRESH_RATE=25
# Hours after /vrcverify_setup before the admin is DMed about a server that
# still has no instruction panel (default 48). 0 nudges on the next sweep.
# PANEL_NUDGE_GRACE_HOURS=48
# How often that check runs, in seconds (default 3600).
# PANEL_NUDGE_INTERVAL=3600
# Ceiling on nudge DMs per sweep, and seconds between them. These exist so a
# backlog or clock jump trickles out instead of looking like a DM blast to
# Discord's anti-spam heuristics.
# PANEL_NUDGE_MAX_PER_SWEEP=20
# PANEL_NUDGE_DM_SPACING=2.0
# Per-user cooldown (seconds) between verification actions, so one user can't
# hammer the shared VRChat account through the bot (bot.py, default 10).
# VERIFICATION_COOLDOWN_SECONDS=10
# In-memory member-fetch cache used to resolve Discord members without
# hitting the REST API every time (bot.py).
# REST_TTL_SECONDS=180
# REST_CACHE_MAX=10000
# REST_CONCURRENCY=8

# --- Internal API for the web dashboard (bot.py, issue #65) ---
# THIS IS THE KILL SWITCH. Leave it unset and no socket is ever opened -- the
# bot behaves exactly as it did before the dashboard existed. That is why this
# code can ship and deploy long before the VPS is ready.
#
# It is the first inbound surface this project has, so before setting it read
# the deployment rules below; they are requirements, not suggestions.
# BOT_API_ENABLED=1
#
# The address to listen on. REQUIRED when enabled, and it must be the tailnet
# address -- the API refuses to start on 0.0.0.0, ::, or a blank value rather
# than quietly listening on every interface. Never publish this port in
# docker-compose, and never open it in the host firewall.
# BOT_API_BIND=100.64.0.2
# BOT_API_PORT=5002
#
# mTLS. Generate all of these with scripts/gen_bot_api_certs.sh (or .ps1) and
# read that file's header for the rotation procedure. The bot demands a client
# certificate on every connection even though the traffic is already inside
# Tailscale: the tunnel is a segmentation control, not an authentication one.
# BOT_API_CERT=/certs/bot-api.pem
# BOT_API_KEY=/certs/bot-api.key
# BOT_API_CA=/certs/ca.pem
# Pins WHICH certificate from that CA may call in. Set it -- without it, any
# leaf the CA ever signs is accepted.
# BOT_API_CLIENT_CN=vrcverify-dashboard
#
# Shared secret signing the per-request tokens that name the acting Discord
# user, the target guild and the operation. Must be IDENTICAL on the bot and
# the dashboard, at least 32 characters, and generated randomly:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The bot refuses to start with a shorter one. To rotate it, follow the
# procedure in scripts/gen_bot_api_certs.sh -- both ends have to change
# together, and the short window where they disagree is the whole story.
# Never pass it on a command line; edit this file and let the process read it.
# BOT_API_TOKEN_SIGNING_KEY=
#
# Token lifetime and permitted clock drift, in seconds. Both are deliberately
# small: together they bound how long a captured request stays replayable.
# BOT_API_TOKEN_TTL=30
# BOT_API_CLOCK_SKEW=5
#
# How long an Administrator verdict is trusted before the bot re-asks Discord
# (default 15). This is how long someone keeps dashboard access after their
# admin role is removed, so keep it short -- it is deliberately NOT the same
# cache as REST_TTL_SECONDS above, which is tuned for verification traffic at
# 180s and would be far too long to leave an authority answer standing.
# BOT_API_ADMIN_TTL=15
#
#
# How long an Administrator verdict is cached before the bot re-asks Discord
# (default 15). This is how long someone keeps dashboard access after their
# admin role is removed, so keep it short. Deliberately NOT the same cache as
# REST_TTL_SECONDS, which is tuned for verification traffic at 180s and would
# be far too long to leave an authority answer standing.
# BOT_API_ADMIN_TTL=15
#
# Request budgets. Per signed-in Discord user, and across everyone at once.
# BOT_API_RATE_LIMIT=60
# BOT_API_RATE_WINDOW=60
# BOT_API_GLOBAL_RATE_LIMIT=600
#
# Budgets for the two routes that CHANGE something, charged on top of the two
# above and deliberately far smaller. A GET is answered from the gateway cache
# and costs Discord nothing; saving a setting or posting a panel turns into
# real Discord REST calls against the same account-wide budget verification
# runs on. Ten a minute is already more than a human configuring a server
# needs, so raise these only if real admins are actually hitting them.
# BOT_API_WRITE_RATE_LIMIT=10
# BOT_API_GLOBAL_WRITE_RATE_LIMIT=60

# --- Stripe, on the DASHBOARD host only (issue #88) ---
# These belong in the dashboard's environment on the VPS. The bot must never
# see them: it holds no Stripe credential of any kind, and the whole
# integration on its side is a table the dashboard fills in over mTLS.
#
# STRIPE_ENABLED is the dashboard's own kill switch and it does three things:
# registers POST /stripe/webhook (unset, that path is a plain 404), builds the
# Stripe client, and makes everything below REQUIRED. The dashboard refuses to
# boot if any of them is missing, because a webhook secret that is absent
# rejects every event Stripe sends while the service looks perfectly healthy.
#
# ORDER MATTERS: turn the BOT's STRIPE_ENABLED on first. With this one on and
# the bot's off, a customer completes checkout, is charged, the forward is
# answered 404 for three days, and premium never switches on.
#
# BEFORE THIS GOES LIVE: the Cloudflare WAF skip rule for /stripe/webhook must
# exist and be verified by a test-mode event actually reaching the origin
# (SECURITY_AUDIT.md A-25). The hostname carries a managed challenge, Stripe is
# not a browser, and the failure is silent -- Stripe sees 403, retries for three
# days, and NOTHING reaches the origin, so nothing appears in these logs.
# STRIPE_ENABLED=1
#
# Secret key (sk_ or a restricted rk_). A publishable pk_ is refused at boot.
# STRIPE_SECRET_KEY=sk_live_...
#
# The signing secret from the webhook endpoint in Stripe -- whsec_..., NOT an
# API key. The two are both opaque strings and confusing them rejects every
# event, so this is checked at boot too.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# The PRODUCT whose active recurring prices are the plans on offer. One id,
# and the plans themselves live in Stripe: creating a price publishes a plan,
# archiving one retires it, and neither is a deploy.
#
# This replaced STRIPE_PRICE_MONTHLY / _SIX_MONTHS / _YEARLY. Those had to be
# edited, deployed and kept matching an account they could not see, and adding
# a fourth plan was a code change. Test and live mode still have different ids,
# which is still why this is environment and not a constant in the source.
#
# Must be a product id (prod_...), not a price id. A price id here matches no
# prices, so the page apologises forever -- checked at boot for that reason.
# STRIPE_PRODUCT_ID=prod_...
#
# WHAT EACH PRICE SAYS ABOUT ITSELF lives in that price's METADATA in Stripe.
# All optional; a price with none still renders, labelled from its own billing
# interval:
#
#   label       "6 months"          overrides the interval-derived label
#   order       "2"                 sort position; default is by term length
#   saving      "Save about 10%"    the green line under the label
#   trial_days  "14"                free trial, in days. Omit for none.
#
# The trial is read from metadata and passed to Checkout, so changing a trial
# is a Stripe dashboard edit. The bot already counts `trialing` as paid, so
# premium switches on when the trial starts.
#
# Prices must be created with "Include tax in price" = No (tax_behavior
# exclusive); automatic tax refuses an unspecified one, and inclusive cannot be
# changed afterwards. They must also be RECURRING -- checkout runs in
# subscription mode, and a one-off price is a 400 when somebody clicks Buy.
#
# Which billing portal configuration a portal session opens with. OPTIONAL --
# the only Stripe variable that is -- and unset means the Stripe account's
# default.
#
# Set it if the Stripe account carries more than one product. A portal
# configuration decides what a customer may do to their own subscription, and
# "switch plans" is one of those things; the account default is shared by every
# product on the account, so its plan list is not necessarily this product's. A
# customer who switches to another product's cheaper recurring price keeps
# premium at that price, and nothing downstream notices: premium is granted on
# subscription STATUS, and an unrecognised price id still counts as paid, on
# purpose, so a catalogue mismatch can never switch off a paying customer.
#
# Do NOT make that configuration the account default when other products share
# the account -- that scopes their customers to this product's plans instead.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# --- docker-compose.deploy.yml only (not read by bot.py directly) ---
# Pinned image tag to deploy; docker-compose.deploy.yml refuses to run
# without it (never "latest" -- see that file's header comment).
# VRCVERIFY_VERSION=1.4.0
# COMPOSE_PROJECT_NAME=vrcverify

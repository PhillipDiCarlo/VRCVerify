# Copy this file to `.env` (gitignored) and fill in real values.
# Both src/bot.py and src/vrc_online_checker.py load it via python-dotenv.

# --- Discord (bot.py) ---
DISCORD_BOT_TOKEN=your-discord-bot-token

# --- Database (bot.py) ---
# PostgreSQL in production; sqlite works for quick local runs:
#   sqlite:///local_test.db
DATABASE_URL=postgresql://user:password@host:5432/vrcverify

# --- RabbitMQ (both services) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_NAME=verification_requests
RABBITMQ_RESULT_QUEUE=verification_results
# NOTE: the request queue is declared with x-max-priority so premium servers are
# served first when a backlog forms. The priority ceiling is a constant in both
# src/bot.py and src/vrc_online_checker.py, NOT an env var — the two must match
# exactly or every declare fails with 406 and both services stop.
# Upgrading from a build without it requires deleting and recreating the queue
# named by RABBITMQ_QUEUE_NAME above (whatever you have set it to — not the
# placeholder here). See "Upgrading to a build with queue priority" in the README.
# Connection tuning, so a stale connection is detected instead of hanging.
# RABBITMQ_HEARTBEAT=60
# RABBITMQ_BLOCKED_TIMEOUT=60
# RABBITMQ_CONN_ATTEMPTS=3
# RABBITMQ_RETRY_DELAY=2
# RABBITMQ_SOCKET_TIMEOUT=10
# Retries for a single publish before giving up (bot.py).
# RABBITMQ_PUBLISH_TRIES=3

# --- VRChat account (vrc_online_checker.py) ---
VRCHAT_USERNAME=your-vrchat-username
VRCHAT_PASSWORD=your-vrchat-password

# --- Gmail IMAP for VRChat 2FA codes (vrc_online_checker.py) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Premium tier: Discord App Subscriptions (bot.py) ---
# The guild-subscription SKU id from Developer Portal → Monetization.
#
# THIS IS THE KILL SWITCH. Leave it unset and premium gating is entirely
# inert — every server behaves exactly like the free bot did. Set it and the
# gates come alive, no redeploy needed. Unset it again to roll the tier back.
#
# Note Discord subscription SKUs bill monthly only; there is no annual option.
# PREMIUM_SKU_ID=1234567890123456789
# Seconds a resolved entitlement is trusted before re-checking with Discord
# (default 900). Purchases don't wait for this — the entitlement gateway
# events invalidate the guild immediately. This only bounds a *missed* event.
# PREMIUM_STATUS_TTL=900
# Per-user cooldown for subscribed servers (default 3). 0 removes the wait.
# PREMIUM_VERIFICATION_COOLDOWN_SECONDS=3
# The grandfather line: servers whose `servers.id` is <= this keep
# unverified-role removal, nickname sync and the custom DM for free, forever.
# Default 820 — where the autoincrementing key stood at the start of July 2026.
# (Auto-verify-on-join is free for every server and isn't affected by this.)
# PREMIUM_GRANDFATHER_MAX_ID=820
# One-time cutover announcement to every server that predates the tier.
# Nothing is sent until this file appears; `touch` it when you're ready, and
# the campaign trickles out and then stops on its own.
# PREMIUM_CUTOVER_TRIGGER_PATH=/tmp/premium_cutover.trigger
# Sweep interval, per-sweep cap, and seconds between sends. Same reasoning as
# the panel nudge: a DM blast across hundreds of servers is what Discord's
# anti-spam heuristics look for.
# PREMIUM_CUTOVER_INTERVAL=300
# PREMIUM_CUTOVER_MAX_PER_SWEEP=20
# PREMIUM_CUTOVER_DM_SPACING=2.0
# Give up after this many consecutive failed sweeps, so a DB outage can't
# wedge the trigger watcher for the life of the process (default 3).
# PREMIUM_CUTOVER_MAX_FAILURES=3

# Verification activity log. Entries are buffered and posted in batches, not
# one message per verification: Discord allows ~5 messages per 5s per channel
# and that budget is shared with verification DMs and command replies.
# Seconds between flushes (default 5).
# VERIFICATION_LOG_FLUSH_INTERVAL=5
# Log messages started per second across all guilds during a flush (default 5).
# VERIFICATION_LOG_RATE=5
# Entries held for one guild between flushes (default 200). Reached only when
# a channel is unreachable or a verification drive outruns the flush; beyond
# it the oldest are dropped and the next batch says how many.
# VERIFICATION_LOG_MAX_BUFFERED=200

# --- Optional ---
LOG_LEVEL=INFO
# VRCHAT_API_CONNECT_TIMEOUT_SECONDS=10
# VRCHAT_API_READ_TIMEOUT_SECONDS=20
# VRCHAT_RELOGIN_INTERVAL_SECONDS=600
# Persist the VRChat auth cookie so restarts skip re-authentication (each
# fresh login burns a 2FA email and VRChat rate-limits that endpoint).
# This file IS a credential: written 0600, keep it off shared storage.
# Unset = disabled. Compose defaults it to /data on a named volume.
# VRCHAT_SESSION_FILE=/data/vrchat_session.txt
# Read bios from VRChat's newer /profile/{id} endpoint (default true).
# /users/{id} can serve a stale bio and break verification; set false to revert.
# VRCHAT_USE_PROFILE_ENDPOINT=true
# INSTRUCTIONS_TRIGGER_PATH=/tmp/update_instructions.trigger
# How many instruction panels are re-attached at once on startup (default 10).
# INSTRUCTIONS_REFRESH_CONCURRENCY=10
# Panel edits started per second (default 25). Discord's global ceiling is ~50
# req/s for the whole bot, so keep headroom here or startup will throttle
# verification traffic too.
# INSTRUCTIONS_REFRESH_RATE=25
# Hours after /vrcverify_setup before the admin is DMed about a server that
# still has no instruction panel (default 48). 0 nudges on the next sweep.
# PANEL_NUDGE_GRACE_HOURS=48
# How often that check runs, in seconds (default 3600).
# PANEL_NUDGE_INTERVAL=3600
# Ceiling on nudge DMs per sweep, and seconds between them. These exist so a
# backlog or clock jump trickles out instead of looking like a DM blast to
# Discord's anti-spam heuristics.
# PANEL_NUDGE_MAX_PER_SWEEP=20
# PANEL_NUDGE_DM_SPACING=2.0
# Per-user cooldown (seconds) between verification actions, so one user can't
# hammer the shared VRChat account through the bot (bot.py, default 10).
# VERIFICATION_COOLDOWN_SECONDS=10
# In-memory member-fetch cache used to resolve Discord members without
# hitting the REST API every time (bot.py).
# REST_TTL_SECONDS=180
# REST_CACHE_MAX=10000
# REST_CONCURRENCY=8

# --- docker-compose.deploy.yml only (not read by bot.py directly) ---
# Pinned image tag to deploy; docker-compose.deploy.yml refuses to run
# without it (never "latest" — see that file's header comment).
# VRCVERIFY_VERSION=1.4.0
# COMPOSE_PROJECT_NAME=vrcverify

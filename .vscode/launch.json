{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            // Serves the dashboard at http://127.0.0.1:5001 with fake
            // credentials, for looking at templates and CSS. Never reads .env
            // and cannot reach the real bot -- see scripts/dev_dashboard.py.
            // Stop it with the red square, or Ctrl+C in the terminal.
            //
            // Signed in against a stub, so the picker, overview, settings,
            // subscription and error pages all render. Four invented servers:
            // premium, free, bot-not-added, and one that always fails. The
            // terminal prints their URLs on start. See scripts/preview_bot.py.
            "name": "Dashboard (local preview)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_dashboard.py",
            "console": "integratedTerminal",
            // The Flask reloader is off in the script, so breakpoints in
            // app.py, the view modules and Jinja stay attached.
            "justMyCode": false,
            "serverReadyAction": {
                "pattern": "Dashboard preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // Signed in, but with the bot refusing every call. This is the
            // only way to see the picker's "unknown" cards and error.html on
            // every section -- an outage is a state the app has real handling
            // for and no other way to reach locally.
            "name": "Dashboard (local preview, bot down)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_dashboard.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PREVIEW_BOT_DOWN": "1" },
            "serverReadyAction": {
                "pattern": "Dashboard preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // The same preview with no session, which is the only way to see
            // the sign-in page -- the entry above lands past it and its
            // sign-out button is inert. Use this one for #134.
            "name": "Dashboard (local preview, signed out)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_dashboard.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PREVIEW_SIGNED_IN": "0" },
            "serverReadyAction": {
                "pattern": "Dashboard preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // Serves the apex marketing site at http://127.0.0.1:5002 --
            // the home page, the three legal pages, What's new and the 404.
            // Static files straight off disk, so a save is visible on reload
            // and there is no build step and nothing to restart.
            //
            // NOT `python -m http.server`, which cannot serve this site: every
            // internal link is extensionless (/terms, not /terms.html) and
            // Cloudflare is what resolves those in production. The script
            // reimplements that, and serves 404.html with a real 404.
            // See scripts/dev_site.py.
            "name": "Apex site (local preview)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_site.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "serverReadyAction": {
                "pattern": "Apex site preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // Serves the status page at http://127.0.0.1:5003 with invented
            // data: an incident open, days that went badly, and the ninety-day
            // strip full. Also /admin, the incident form.
            //
            // NOT `wrangler dev`, which is the real Worker and is what to use
            // for routing, /api/status.json or the cron. It installs wrangler
            // on every start and begins with an empty D1, so the history
            // strip, the banner and the folded timelines -- most of what there
            // is to look at -- are absent until somebody writes rows by hand.
            //
            // The page itself is rendered by node in a container, because
            // render.js is JavaScript and this machine has no node. Docker has
            // to be running. See scripts/dev_status.py.
            "name": "Status page (local preview)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_status.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "serverReadyAction": {
                "pattern": "Status page preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // THE SAME PAGE, RIGHT TO LEFT (#300). Arabic is the only one of
            // the twelve that arrives under dir="rtl", so it is the only one
            // where reading the CSS answers nothing: which end of a row a
            // pill sits at, which way the disclosure chevron points, and
            // which side the language menu opens on are all things a
            // screenshot decides. The other eleven are reachable from the
            // picker in the header once this is running.
            "name": "Status page (local preview, in Arabic)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_status.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PREVIEW_LOCALE": "ar" },
            "serverReadyAction": {
                "pattern": "Status page preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // The page as it is almost all of the time: everything up, no
            // incidents. This is the one to check the empty states on -- the
            // "nothing has gone wrong" line, and how the incident column
            // reads with nothing in it.
            "name": "Status page (local preview, all clear)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_status.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PREVIEW_STATE": "clear" },
            "serverReadyAction": {
                "pattern": "Status page preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            // The checker has stopped reporting. Every row is drawn unknown
            // however good the stored state was, which is the rule the whole
            // page is built around and the state most likely to be broken by
            // a change. There is no other way to reach it locally.
            "name": "Status page (local preview, checker stopped)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_status.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PREVIEW_STATE": "stale" },
            "serverReadyAction": {
                "pattern": "Status page preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Bot.py Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/bot.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Online Checker Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/vrc_online_checker.py",
            "console": "integratedTerminal"
        },
        {
            "name": "test VRC file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/test_vrc.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "purpose": ["debug-test"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            // Serves the dashboard at http://127.0.0.1:5001 with fake
            // credentials, for looking at templates and CSS. Never reads .env
            // and cannot reach the real bot -- see scripts/dev_dashboard.py.
            // Stop it with the red square, or Ctrl+C in the terminal.
            "name": "Dashboard (local preview)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev_dashboard.py",
            "console": "integratedTerminal",
            // The Flask reloader is off in the script, so breakpoints in
            // app.py, the view modules and Jinja stay attached.
            "justMyCode": false,
            "serverReadyAction": {
                "pattern": "Dashboard preview: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Bot.py Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/bot.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Online Checker Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/vrc_online_checker.py",
            "console": "integratedTerminal"
        },
        {
            "name": "test VRC file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/test_vrc.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "purpose": ["debug-test"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
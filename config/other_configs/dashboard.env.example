# Environment for the web dashboard, on the public VPS (issues #65, #88).
#
# Copy to `dashboard.env` beside docker-compose.dashboard.yml on the VPS, fill
# it in, and `chmod 600` it. It is read by `env_file:` -- nothing here reaches
# the bot, and nothing in the homelab's .env reaches this file.
#
# WHY THIS FILE IS SEPARATE FROM THE REPO ROOT .env, AND MUST STAY SEPARATE:
#
# The root .env is the homelab's (bot.py + vrc_online_checker.py). This one is
# the VPS's. They share exactly two variable NAMES -- STRIPE_ENABLED, and the
# signing key below -- and no values beyond the signing key, which must match.
# The split is the security model, not filing preference:
#
#   * The dashboard holds NO DATABASE_URL and NO DISCORD_BOT_TOKEN. It asks the
#     bot for everything over mTLS. Adding either here would hand a full
#     compromise of this public box a direct route to the users table, which is
#     the single reason the bot API exists. Do not add them "just for now".
#
#   * The bot holds NO Stripe credential, in either direction. The Stripe keys
#     below live on this host alone.
#
# Every variable is read by src/dashboard/config.py. That module refuses to
# start on a bad value rather than coming up half-configured -- each refusal
# below is deliberate, and the comment says what it prevents.


# --- Discord OAuth ---
# The application's client id and secret, from the Discord developer portal
# (Applications -> your app -> OAuth2). The client id is public; the secret is
# not, and rotating it in the portal invalidates this value immediately.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where Discord sends the authorisation code. This must ALSO be registered
# verbatim as a redirect in the portal's OAuth2 -> Redirects list; Discord
# compares them exactly, and a trailing slash is a mismatch.
#
# REQUIRED to be https (config.py:_validate_redirect). Over plain http the
# authorisation code crosses the network in the clear and can be stolen and
# exchanged before the real user's browser arrives. http is permitted only for
# localhost, for local development.
OAUTH_REDIRECT_URI=https://dashboard.example.com/callback


# --- Sessions ---
# Flask signs the session cookie with this. The cookie carries only an opaque
# session id, but forging one is still forging a session, so it gets the same
# floor as the signing key below: at least 32 characters, and random.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# CHANGING THIS SIGNS EVERYONE OUT. That is the correct response to a suspected
# leak, and an avoidable annoyance otherwise -- so generate it once and keep it.
# It must also DIFFER from BOT_API_TOKEN_SIGNING_KEY: two different trust
# domains, one signing cookies handed to browsers and one authorising calls
# into the homelab. Sharing them turns a cookie-signing bug into an
# API-forgery bug, and config.py refuses to start if they are equal.
DASHBOARD_SECRET_KEY=

# Session store. Defaults to /data/sessions.db, which is the named volume in
# docker-compose.dashboard.yml -- a named volume specifically so that
# `docker compose down` does not sign every user out. /data is also the only
# writable path in the container (the root filesystem is read_only), so this
# should not be moved without changing that file too.
# SESSION_DB_PATH=/data/sessions.db


# --- The bot API, over Tailscale + mTLS ---
# The bot's tailnet address. REQUIRED to be https: the mTLS IS the
# authentication here, and plain http would discard it. The tailnet is a
# segmentation control, not an authentication one -- which is why there is a
# client certificate even though the traffic never leaves the tailnet.
BOT_API_URL=https://100.64.0.2:5002

# The dashboard's client certificate, its key, and the CA that signed the
# bot's. Generated by scripts/gen_bot_api_certs.sh; read that file's header
# before rotating, because both ends have to change together. These paths are
# inside the container -- docker-compose.dashboard.yml mounts ./certs at /certs
# read-only, so they change only if you change that mount.
BOT_API_CLIENT_CERT=/certs/dashboard.pem
BOT_API_CLIENT_KEY=/certs/dashboard.key
BOT_API_CA=/certs/ca.pem

# Shared secret signing the per-request tokens that name the acting Discord
# user, the target guild and the operation.
#
# MUST BE BYTE-IDENTICAL TO THE BOT'S BOT_API_TOKEN_SIGNING_KEY. Not "the same
# kind of value" -- the same value. If they disagree the dashboard renders
# fine, signs you in fine, and then every action fails, because the failure is
# on the bot's side of a link you cannot see from here.
#
# At least 32 characters, generated randomly:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never pass it on a command line; edit this file and let the process read it.
BOT_API_TOKEN_SIGNING_KEY=


# --- Optional tuning. Defaults are in src/dashboard/config.py. ---
# Session lifetime, seconds (default 28800 = 8h).
# DASHBOARD_SESSION_MAX_AGE=28800
#
# How long the dashboard reuses the bot's answer about which guilds you
# administer, seconds (default 900).
# DASHBOARD_GUILD_CACHE_TTL=900
#
# Timeout on calls to the bot API and to Stripe, seconds (default 10).
# DASHBOARD_REQUEST_TIMEOUT=10


# --- Stripe (issue #88). THIS HOST ONLY. ---
# STRIPE_ENABLED is the dashboard's kill switch and it does three things:
# registers POST /stripe/webhook (with it unset that path is a plain 404),
# builds the Stripe client, and makes all five variables below REQUIRED. The
# dashboard REFUSES TO BOOT if any one of them is missing -- a webhook secret
# that is absent rejects every event Stripe sends while the service looks
# perfectly healthy doing it, and a missing price id renders a plan card that
# 500s when somebody clicks Buy. Both are worse than not starting.
#
# DO NOT SET THIS UNTIL THE CLOUDFLARE SKIP RULE IS VERIFIED. POST
# /stripe/webhook is authenticated by Stripe's signature rather than by a
# session, and it arrives through the same hostname as everything else -- so
# the managed challenge on this hostname has to be skipped for that one path,
# or Stripe is challenged, sees a 403, and retries for three days while NOTHING
# reaches this origin and nothing appears in these logs. That is SECURITY_AUDIT
# item A-25. The rule must be path-scoped and never hostname-wide, and it has
# to be proven by a real test-mode event BEFORE this line is uncommented.
# STRIPE_ENABLED=1

# Secret key (sk_... or rk_...). config.py rejects a publishable pk_ key, which
# would otherwise fail every call at runtime instead of at boot.
STRIPE_SECRET_KEY=

# The signing secret from the webhook ENDPOINT (whsec_...), not an API key.
# Found under Developers -> Webhooks -> your endpoint -> Signing secret. It is
# per-endpoint, so the test-mode and live-mode endpoints have different ones.
STRIPE_WEBHOOK_SECRET=

# The PRODUCT whose active recurring prices are the plans on offer.
#
# The plans live in Stripe, not here: creating a price publishes a plan and
# archiving one retires it, with no deploy either way. This replaced three
# STRIPE_PRICE_* variables that had to be kept matching an account they could
# not see.
#
# It does NOT mean the browser may name a price. The form submits a price id
# and the checkout route accepts it only after finding it among this product's
# active prices, fetched from Stripe on that request -- so a $0 price made
# while testing is refused, and so is anything at all if Stripe cannot be
# reached to check.
#
# Must be a product id (prod_...). A price id here matches no prices and the
# page apologises forever, so it is checked at boot.
STRIPE_PRODUCT_ID=

# Which billing portal configuration a portal session opens with (bpc_...).
# OPTIONAL, and the only Stripe variable here that is -- leave it unset and
# Stripe uses the account default, which is what shipped.
#
# Set it if this Stripe account carries more than one product. A portal
# configuration decides what a customer may do to their own subscription, and
# "switch plans" is one of those things. The account default is shared by every
# product on the account, so its plan list is not necessarily this product's --
# and a customer who switches to another product's cheaper recurring price
# keeps premium at that price. The bot cannot catch it: premium is granted on
# subscription STATUS, and an unrecognised price id still counts as paid, on
# purpose, so that a catalogue mismatch never switches off a paying customer.
#
# Create one under Settings -> Billing -> Customer portal, scoped to this
# product's prices, and name it here. Do not make it the account DEFAULT if
# other products share the account -- that scopes their customers to this
# product's plans instead.
STRIPE_PORTAL_CONFIGURATION_ID=

# --- What each price says about itself: set in Stripe, not here ---
#
# Each price's METADATA in the Stripe dashboard drives its card. All optional;
# a price with no metadata still renders, labelled from its billing interval.
#
#   label       "6 months"          overrides the interval-derived label
#   order       "2"                 sort position; default is by term length
#   saving      "Save about 10%"    the green line under the label
#   trial_days  "14"                free trial, in days. Omit for none.
#
# Prices must be RECURRING (checkout runs in subscription mode; a one-off price
# is a 400 when somebody clicks Buy) and created with "Include tax in price" =
# No. Automatic tax refuses an unspecified tax_behavior, and inclusive cannot
# be changed afterwards -- you would have to make new prices and migrate
# subscribers.

# --- The VRCVerify Discord (issue #138) ---
#
# Offered at the foot of the changelog page and in the bell panel, so an admin
# can follow the announcement channel and have updates crossposted into their
# own server.
#
# THE SAME VALUE the bot's own .env carries. Two hosts, two files, and they
# deploy independently -- so one will have it before the other. Neither is
# broken while they disagree: an unset value renders no row at all rather than
# a dead one, on both sides.
#
# Must include the scheme. A bare "discord.gg/..." is refused, because a
# schemeless href resolves relative to the dashboard's own domain: the row
# would look like an ordinary link and 404 on our own site instead of reaching
# Discord. Use a NON-EXPIRING invite.
#
# THIS VALUE LIVES IN THREE PLACES -- here, the bot host's .env, and a constant
# in scripts/gen_changelog.py for the static site. Nothing detects a miss. See
# "Rotating the invite" in site/README.md before changing it.
# SUPPORT_INVITE_URL=https://discord.gg/yourinvite

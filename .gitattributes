# Shell scripts are written on Windows but run on the Linux deploy host, where
# CRLF line endings produce "bad interpreter: /bin/bash^M" and the script never
# runs. Pin them to LF so this does not depend on each clone's core.autocrlf.
*.sh text eol=lf

# PowerShell scripts are the Windows-side counterparts.
*.ps1 text eol=crlf

# The vendored webfont. Marked binary so no clone's core.autocrlf setting can
# "fix" line endings inside it -- a WOFF2 with a handful of 0x0D bytes rewritten
# is a corrupt font that fails to decode, and the failure looks like a styling
# bug rather than a mangled file.
*.woff2 binary
